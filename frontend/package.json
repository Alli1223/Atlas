{
  "name": "atlas-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:api": "openapi-typescript http://127.0.0.1:8080/api/openapi.json -o src/lib/api-schema.d.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.1",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "2.2.2",
    "@atlaskit/pragmatic-drag-and-drop-react-drop-indicator": "4.2.2",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@tiptap/extension-code-block-lowlight": "3.31.3",
    "@tiptap/extension-mention": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "immer": "11.1.18",
    "lowlight": "3.3.0",
    "lucide-react": "1.47.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/react-query-devtools": "5.103.1",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "^1.61.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.10"
  }
}
