# =============================================================================
# Atlas configuration
# =============================================================================
#
# Copy to `.env` and edit:
#
#     cp .env.example .env
#
# Atlas does NOT read `.env` itself — that is the job of your shell, `just dev`,
# docker-compose, or your process supervisor. The process only reads real
# environment variables (and, optionally, a TOML file: see ATLAS_CONFIG_FILE).
#
# Every variable below is OPTIONAL and shown with its built-in default, with one
# exception: ATLAS_MASTER_KEY is REQUIRED when ATLAS_ENV=prod. Atlas fails fast
# at startup and names the variable at fault rather than failing later.
#
# Precedence, lowest to highest:  built-in defaults  <  TOML file  <  ATLAS_*
#
# `.env` is gitignored. Never commit it.


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# Address and port the HTTP server binds to.
# Defaults to loopback: Atlas has no authentication until Phase 2, and binding
# 0.0.0.0 would expose it to your whole network. Use 0.0.0.0:8080 inside a
# container, where loopback is the container's own.
ATLAS_BIND_ADDR=127.0.0.1:8080

# Deployment environment: `dev` or `prod`.
# Controls the log format default and whether ATLAS_MASTER_KEY is mandatory.
ATLAS_ENV=dev


# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------

# SQLite connection URL. A relative path is relative to the working directory.
# The file, plus its -wal and -shm sidecars, is the entire database — back it up
# by copying all three (or better: `VACUUM INTO`).
#
# WAL requires a LOCAL filesystem. It breaks on NFS and on some container bind
# mounts; use a named volume rather than a bind mount if you hit locking errors.
ATLAS_DATABASE_URL=sqlite://data/atlas.db

# Directory for the database, uploads and attachments. Created at startup.
ATLAS_DATA_DIR=data

# Directory for cloned repositories and Claude Code agent workspaces (Phase 13).
# Created at startup. Can grow large — one full clone per linked project.
ATLAS_WORKSPACE_DIR=workspaces

# Number of connections in the read pool.
# The WRITE pool is always exactly 1 and is not configurable: SQLite permits one
# writer at a time, so a larger write pool would only convert in-process
# serialisation into SQLITE_BUSY errors. Raising this helps read concurrency;
# each connection costs its own page cache (see cache_size in backend/src/db).
ATLAS_READER_POOL_SIZE=8

# Directory to serve the built frontend assets from.
# When absent (the default) no static files are served — the Vite dev server proxies instead.
# The Docker image sets this automatically to /app/static. For a bare-binary deploy, set it to
# the path of the `frontend/dist` directory produced by `npm run build`.
#ATLAS_STATIC_DIR=frontend/dist


# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# `tracing` filter directives, same grammar as RUST_LOG.
# RUST_LOG, if set, OVERRIDES this — handy for a one-off debug session:
#     RUST_LOG=atlas=trace cargo run
ATLAS_LOG_LEVEL=info,atlas=debug,tower_http=info,sqlx=warn

# Log rendering: `pretty` or `json`.
# Unset means pretty when ATLAS_ENV=dev, json when ATLAS_ENV=prod. Only set this
# to override that (e.g. json locally to test a log pipeline).
#ATLAS_LOG_FORMAT=pretty


# -----------------------------------------------------------------------------
# Web / CORS
# -----------------------------------------------------------------------------

# Comma-separated list of browser origins allowed to call the API.
# Defaults to the Vite dev server. In production, where Atlas serves the
# frontend from its own origin, CORS is not used at all and this can be ignored.
#
# `*` is accepted but DISABLES cookie authentication: the CORS specification
# forbids credentials alongside a wildcard origin. Atlas logs a warning if you
# do this. Prefer an explicit list.
ATLAS_CORS_ALLOWED_ORIGINS=http://localhost:5173


# -----------------------------------------------------------------------------
# Secrets  (Phase 11 — the vault)
# -----------------------------------------------------------------------------

# Master key for encrypting API credentials (GitHub PATs, Gemini keys, SMTP
# passwords) at rest. Base64-encoded 32 random bytes.
#
# Generate one:
#
#     openssl rand -base64 32
#
# or, without openssl:
#
#     head -c 32 /dev/urandom | base64
#
# REQUIRED when ATLAS_ENV=prod; optional in dev, where the vault stays sealed
# and integrations are simply unavailable until you set it.
#
# LOSING THIS KEY MEANS LOSING EVERY STORED CREDENTIAL. They cannot be
# recovered from the database — you would have to re-enter each one. Back it up
# somewhere other than the machine running Atlas, and separately from the
# database backup (a backup containing both the ciphertext and its key protects
# nothing).
#
# Prefer injecting this from a secret manager or systemd credential over putting
# it in a file. If it must live in a file, `chmod 600` it.
#
# Rotating it: Phase 11 stores a key id per secret, so old ciphertexts stay
# readable across a rotation.
#ATLAS_MASTER_KEY=


# -----------------------------------------------------------------------------
# Advanced
# -----------------------------------------------------------------------------

# Path to a TOML config file, read before ATLAS_* variables are applied.
# Keys are the lowercase names without the ATLAS_ prefix, e.g.:
#
#     bind_addr = "0.0.0.0:8080"
#     reader_pool_size = 16
#
# A missing file is not an error. Defaults to `atlas.toml` in the working
# directory.
#ATLAS_CONFIG_FILE=atlas.toml
